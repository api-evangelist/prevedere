{
  "opencollection": "1.0.0",
  "info": {
    "name": "Board Foresight API - V1 Alert Favorites API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiKey",
      "value": "{{ApiKey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Favorites",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /favorites",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/favorites"
          },
          "docs": "Retrieves all the favorites-lists for the company"
        },
        {
          "info": {
            "name": "GET /favorite/{Id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/favorite/:Id",
            "params": [
              {
                "name": "Id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves the specified favorite"
        }
      ]
    }
  ],
  "bundled": true
}