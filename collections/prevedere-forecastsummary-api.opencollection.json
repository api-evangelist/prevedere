{
  "opencollection": "1.0.0",
  "info": {
    "name": "Board Foresight API - V1 Alert ForecastSummary API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiKey",
      "value": "{{ApiKey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "ForecastSummary",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /summaries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/summaries"
          }
        },
        {
          "info": {
            "name": "GET /forecast/summary/{forecastSummaryId}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/forecast/summary/:forecastSummaryId",
            "params": [
              {
                "name": "forecastSummaryId",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}