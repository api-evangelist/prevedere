{
  "opencollection": "1.0.0",
  "info": {
    "name": "Board Foresight API - V1 Alert Provider API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiKey",
      "value": "{{ApiKey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Provider",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /provider",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/provider"
          },
          "docs": "Retrieves complete list of providers with data in the system. A provider is an entity or organization that publishes indicator data"
        }
      ]
    }
  ],
  "bundled": true
}