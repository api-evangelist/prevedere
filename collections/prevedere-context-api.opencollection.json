{
  "opencollection": "1.0.0",
  "info": {
    "name": "Board Foresight API - V1 Alert Context API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiKey",
      "value": "{{ApiKey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Context",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves current User Context (Company, Features, Roles, User)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/context"
          },
          "docs": "User context"
        }
      ]
    }
  ],
  "bundled": true
}