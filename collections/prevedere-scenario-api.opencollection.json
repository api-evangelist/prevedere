{
  "opencollection": "1.0.0",
  "info": {
    "name": "Board Foresight API - V1 Alert Scenario API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiKey",
      "value": "{{ApiKey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Scenario",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /scenarios",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/scenarios"
          },
          "docs": "Retrieves a list of scenarios names and Ids for a user's company"
        },
        {
          "info": {
            "name": "GET /scenario/{scenarioId}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/scenario/:scenarioId",
            "params": [
              {
                "name": "scenarioId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a scenario by its Id"
        }
      ]
    }
  ],
  "bundled": true
}